# Safe local defaults. Do not put credentials in this file.
APP_ENV=local
EMBEDDING_COMPUTE_PROVIDER=mock
JACGRID_BASE_URL=http://127.0.0.1:8000
JACGRID_SERVICE_TOKEN=
FIXTURE_IDENTITY_ENABLED=true

# Server-side Stage 1.5 match explanations. Never expose this key to the client.
OPENAI_API_KEY=
BYLLM_DEFAULT_MODEL=gpt-5.6-terra
CONNECTION_EXPLANATIONS_MODE=openai
