{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connection-agent.local/contracts/workload/v1/result.schema.json",
  "title": "Connection Embedding File Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "__jacgrid_execution"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "embedding"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "embedding": {
            "type": "array",
            "minItems": 384,
            "maxItems": 384,
            "items": {"type": "number"}
          }
        }
      }
    },
    "__jacgrid_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "enum": [
            "connection-embedding:1.0.0",
            "connection-embedding-fallback:1.0.0"
          ]
        }
      }
    }
  }
}
