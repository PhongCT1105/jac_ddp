{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connection-agent.local/contracts/workload/v1/output.schema.json",
  "title": "Connection Embedding Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "model", "dimensions", "normalized", "results"],
  "properties": {
    "contract_version": {"const": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "artifact_sha256"],
      "properties": {
        "id": {"const": "fixture-token-hash"},
        "revision": {"const": "fixture-token-hash-v1"},
        "artifact_sha256": {
          "const": "sha256:d681e8a394df13cc28fb809dc5a1f66f4b66310bb42e259adb9a344d87fcc070"
        }
      }
    },
    "dimensions": {"const": 16},
    "normalized": {"const": true},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "embedding"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "embedding": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {"type": "number"}
          }
        }
      }
    }
  }
}
