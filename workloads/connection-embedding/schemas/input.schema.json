{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connection-agent.local/contracts/workload/v1/task.schema.json",
  "title": "Connection Embedding Task V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "job_type", "payload"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "job_type": {"const": "embedding"},
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["items"],
      "properties": {
        "model": {"type": "string"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
