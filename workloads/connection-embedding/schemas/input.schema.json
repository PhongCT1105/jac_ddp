{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connection-agent.local/contracts/workload/v1/input.schema.json",
  "title": "Connection Embedding Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "items"],
  "properties": {
    "contract_version": {"const": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
