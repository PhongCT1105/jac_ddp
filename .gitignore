*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Jac local runtime state
.jac/
**/.jac/cache/
**/.jac/data/
**/.jac/logs/

